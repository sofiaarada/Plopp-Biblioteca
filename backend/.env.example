# ── Servidor ───────────────────────────────────────────────
PORT=4000

# ── Base de datos MySQL ────────────────────────────────────
# Usa los valores de tu servicio MySQL de Aiven (o local).
DB_HOST=127.0.0.1
DB_PORT=3300
DB_USER=root
DB_PASSWORD=root
DB_NAME=bibliotecaFerry_db

# Número máximo de conexiones del pool (opcional)
DB_CONNECTION_LIMIT=10

# ── SSL (obligatorio en Aiven) ─────────────────────────────
# Aiven exige conexión TLS. Pónlo en 'true' en producción.
DB_SSL=false
# Ruta a un archivo .pem con el certificado CA (local), o:
DB_CA_CERT_PATH=certs/ca.pem
# O pega el contenido del ca.pem en una sola línea (con \n), o:
DB_CA_CERT=
# Solo si conectas por IP directa (DB_HOST = IP): el hostname real
# del servicio para validar el certificado.
DB_SERVERNAME=mysql-xxxx.g.aivencloud.com

# ── Seguridad / OAuth ──────────────────────────────────────
JWT_SECRET=tu_clave_secreta_super_secreta
GOOGLE_CLIENT_ID=tu_client_id_de_google.apps.googleusercontent.com
