# ============================================================
#  CONFIG PARA AIVEN (producción en la nube)
#  Copia estos valores al archivo .env para conectar a Aiven.
#  IMPORTANTE: usa TUS credenciales reales, no los placeholders.
# ============================================================
PORT=4000

# Base de datos Aiven (MySQL en la nube)
DB_HOST=tu-host.aivencloud.com
DB_PORT=10432
DB_USER=avnadmin
DB_PASSWORD=TU_CONTRASEÑA_DE_AIVEN
DB_NAME=bibliotecaFerry_db

# SSL: Aiven lo exige
DB_SSL=true
DB_CA_CERT_PATH=certs/ca.pem
DB_SERVERNAME=tu-host.aivencloud.com
