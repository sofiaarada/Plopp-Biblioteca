# ============================================================
#  CONFIG PARA MYSQL LOCAL (desarrollo en tu PC)
#  Copia estos valores al archivo .env cuando quieras correr local
# ============================================================
PORT=4000

# Base de datos local (MySQL instalado en tu PC)
DB_HOST=127.0.0.1
DB_PORT=3300
DB_USER=root
DB_PASSWORD=root
DB_NAME=bibliotecaferry_db

# SSL: en local NO se usa
DB_SSL=false
DB_CA_CERT_PATH=
DB_SERVERNAME=
