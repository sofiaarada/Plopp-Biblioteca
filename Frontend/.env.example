# Copia este archivo como ".env" y completa tus credenciales para activar
# el login con Google y Facebook. Mientras estén vacías, los botones
# se ven igual pero muestran un aviso en vez de iniciar sesión de verdad.

# Google Cloud Console → APIs & Servicios → Credenciales → ID de cliente OAuth 2.0
VITE_GOOGLE_CLIENT_ID=

# Facebook for Developers → Mis apps → Configuración básica → ID de la app
VITE_FACEBOOK_APP_ID=
